<form class="npc-log-settings-form">
  <header class="npc-log-settings-header">
    <div>
      <h2>{{localize "NPCLOG.Settings.App.Title"}}</h2>
      <p>{{localize "NPCLOG.Settings.App.Intro"}}</p>
    </div>
  </header>

  <div class="npc-log-settings-body">
    <section class="npc-log-settings-panel">
      <div class="npc-log-settings-panel__header">
        <h3>{{localize "NPCLOG.Settings.App.TargetSection"}}</h3>
      </div>

      <div class="form-group">
        <label for="npc-log-target-journal">{{localize "NPCLOG.Settings.TargetJournal.Name"}}</label>
        <select id="npc-log-target-journal" name="targetJournalUuid">
          <option value="">{{localize "NPCLOG.Settings.App.NoJournal"}}</option>
          {{selectOptions journals selected=settings.targetJournalUuid valueAttr="value" labelAttr="label"}}
        </select>
        <p class="notes">{{localize "NPCLOG.Settings.TargetJournal.Hint"}}</p>
      </div>

      <div class="form-group">
        <label for="npc-log-target-page">{{localize "NPCLOG.Settings.TargetPage.Name"}}</label>
        <select id="npc-log-target-page" name="targetPageUuid">
          <option value="">{{localize "NPCLOG.Settings.App.NoPage"}}</option>
          {{selectOptions pages selected=settings.targetPageUuid valueAttr="value" labelAttr="label"}}
        </select>
        <p class="notes">{{localize "NPCLOG.Settings.TargetPage.Hint"}}</p>
      </div>
    </section>

    <section class="npc-log-settings-panel">
      <div class="npc-log-settings-panel__header">
        <h3>{{localize "NPCLOG.Settings.Advanced.Title"}}</h3>
      </div>

      <label class="checkbox npc-log-setting-toggle npc-log-settings-checkbox-row">
        <span>{{localize "NPCLOG.Settings.Advanced.Enabled.Name"}}</span>
        <input type="checkbox" name="advancedSettingsEnabled" {{checked settings.advancedSettingsEnabled}}>
      </label>
      <p class="notes">{{localize "NPCLOG.Settings.Advanced.Enabled.Hint"}}</p>

      <div class="npc-log-advanced-block" data-advanced-settings>
        <div class="form-group">
          <label for="npc-log-duplicate-mode">{{localize "NPCLOG.Settings.DuplicateMode.Name"}}</label>
          <select id="npc-log-duplicate-mode" name="duplicateMode">
            {{selectOptions duplicateModes selected=settings.duplicateMode valueAttr="value" labelAttr="label" localize=true}}
          </select>
          <p class="notes">{{localize "NPCLOG.Settings.DuplicateMode.Hint"}}</p>
        </div>

        <div class="form-group stacked npc-log-additional-fields-group">
          <label>{{localize "NPCLOG.Settings.CustomFields.Name"}}</label>
          <div class="npc-log-additional-fields" data-additional-fields>
            {{#each additionalFields}}
              {{#if isPlaceholder}}
                <div class="npc-log-additional-field-row npc-log-additional-field-row--placeholder" data-additional-field-placeholder>
                  <select name="additionalFieldChoice">
                    {{selectOptions choices valueAttr="value" labelAttr="label"}}
                  </select>
                </div>
              {{else}}
                {{#if isCustom}}
                  <div class="npc-log-additional-field-row npc-log-custom-field-row {{#if enabled}}is-enabled{{/if}}" data-custom-field>
                    <input type="hidden" name="customFieldId" value="{{id}}">
                    <label class="checkbox">
                      <input type="checkbox" name="customFieldEnabled" {{checked enabled}}>
                      <input type="text" name="customFieldLabel" value="{{label}}" placeholder="{{localize "NPCLOG.Settings.CustomFields.LabelPlaceholder"}}" maxlength="80" {{#unless enabled}}disabled{{/unless}}>
                    </label>
                    <input type="text" name="customFieldOptions" value="{{optionsText}}" placeholder="{{localize "NPCLOG.Settings.CustomFields.OptionsPlaceholder"}}" maxlength="240" {{#unless enabled}}disabled{{/unless}}>
                    <button type="button" data-delete-custom-field data-tooltip="{{localize "NPCLOG.Settings.CustomFields.Delete"}}" aria-label="{{localize "NPCLOG.Settings.CustomFields.Delete"}}" {{#unless enabled}}hidden{{/unless}}>
                      <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                  </div>
                {{else}}
                  <div class="npc-log-additional-field-row {{#if isRelationship}}npc-log-additional-field-row--with-control{{/if}} {{#if enabled}}is-enabled{{/if}}" data-additional-field data-setting="{{setting}}">
                    <label class="checkbox">
                      <input type="checkbox" name="additionalFieldEnabled" value="{{setting}}" {{checked enabled}}>
                      <span>{{label}}</span>
                    </label>
                    {{#if isRelationship}}
                      <select id="npc-log-relationship-default" name="relationshipDefault" data-relationship-default>
                        {{selectOptions relationshipDefaults selected=relationshipDefault valueAttr="value" labelAttr="label" localize=true}}
                      </select>
                    {{/if}}
                  </div>
                {{/if}}
              {{/if}}
            {{/each}}
          </div>

          <p class="notes">{{localize "NPCLOG.Settings.CustomFields.Hint"}}</p>
        </div>
      </div>
    </section>
  </div>

  <footer class="form-footer npc-log-settings-footer">
    <button type="button" data-action="save">
      <i class="fas fa-save" aria-hidden="true"></i>
      {{localize "NPCLOG.Settings.App.Save"}}
    </button>
  </footer>
</form>
